# The game: bring your own copy (see README.md). Never commit it.
# No trailing slash, so a symlink to the game elsewhere is ignored too.
/game

# Lifted from the game, so it is game code: generated on your machine only.
src/recomp/

# Pipeline stage outputs and the build.
.pipeline/
build/

*.log
*.d3dcap
__pycache__/

xboxrecomp/
# Local-only mod work: characters and assets that are not ours to publish
# (docs/modding.md, "Keeping a character private").
private/

# macOS Finder files, at any depth ("./.DS_Store" matched nothing).
.DS_Store

# Local testing beside the checkout: frame dumps and screenshots of the
# game, the save backup, and third-party runtimes. None of it is ours to
# publish.
/dumps/
/remix/
/udata-backup/
